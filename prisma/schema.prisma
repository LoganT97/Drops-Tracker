generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------

model User {
  id           String    @id @default(cuid())
  discordId    String    @unique
  username     String
  avatarUrl    String?
  role         Role      @default(MEMBER)
  lastLoginAt  DateTime?
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())

  // ROI settings — each person's own state and selling costs
  /// ZIP or Canadian postal code, used to look the tax rate up. Stored so a
  /// dataset refresh can update everyone's rate without them retyping it.
  postalCode        String?
  taxRate           Decimal @default(0.0) @db.Decimal(6, 5) // 0.0825 = 8.25%
  marketplaceFeePct Decimal @default(0.0) @db.Decimal(6, 5) // 0.1275 = 12.75%
  shippingCost      Decimal @default(0.0) @db.Decimal(10, 2)

  products        Product[]        @relation("ProductCreatedBy")
  auditLogs       AuditLog[]       @relation("AuditActor")
  watchlist       WatchlistEntry[]
  gmailConnection GmailConnection?
  orders          OrderRecord[]
  orderMessages   OrderMessage[]
}

enum Role {
  ADMIN
  MEMBER
}

/// Pre-approve people before they ever log in. Matched on Discord ID.
model Whitelist {
  id        String   @id @default(cuid())
  discordId String   @unique
  note      String?
  createdAt DateTime @default(now())
}

// ---------- Catalog ----------

enum Retailer {
  TARGET
  WALMART
}

/// Everything here is typed in by a member. No scraping, no API keys.
model Product {
  id          String   @id @default(cuid())
  retailer    Retailer @default(TARGET)
  /// Target TCIN, Walmart item ID, or whatever you use to find it
  sku         String
  productName String
  brand       String   @default("Pokemon")
  imageUrl    String?
  productUrl  String?

  retailPrice Decimal   @db.Decimal(10, 2)
  marketPrice Decimal?  @db.Decimal(10, 2)
  notes       String?
  /// Manually mark products that have not reached their general release date.
  prerelease  Boolean   @default(false)
  releaseDate DateTime? @db.Date

  /// Link to a TCGplayer product. When set, the nightly sync overwrites
  /// marketPrice automatically. Leave null to keep typing prices by hand.
  tcgProductId  Int?
  tcgCategoryId Int?
  tcgGroupId    Int?

  active   Boolean  @default(true)
  /// Bumped whenever someone edits a price, so the table can show staleness
  pricedAt DateTime @default(now())

  snapshots  PriceSnapshot[]
  auditLogs  AuditLog[]
  dropEvents DropEvent[]
  watchedBy  WatchlistEntry[]
  orderItems OrderItem[]

  createdById String?
  createdBy   User?    @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([retailer, sku])
  @@index([active])
}

model DropEvent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  dropDate  DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([productId, dropDate])
  @@index([productId, dropDate])
}

/// Drop alerts whose TCIN is not in the catalog yet. Admins can connect these
/// later without losing the historical dates from the original import.
model UntrackedDropEvent {
  id        String   @id @default(cuid())
  retailer  Retailer @default(TARGET)
  sku       String
  dropDate  DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([retailer, sku, dropDate])
  @@index([retailer, sku, dropDate])
}

model WatchlistEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

// ---------- Order tracking ----------

/// A separately linked Gmail mailbox. Discord remains the sign-in provider;
/// this record only grants read access for importing retailer order emails.
model GmailConnection {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                    String
  accessTokenEncrypted     String
  refreshTokenEncrypted    String?
  tokenExpiresAt           DateTime?
  lastHistoryId            String?
  lastSyncedAt             DateTime?
  lastError                String?
  orderHistoryPageToken    String?
  orderHistoryScanned      Int       @default(0)
  orderHistoryBackfilledAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

enum OrderStatus {
  ORDERED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  DELAYED
  UNKNOWN
}

/// Retailer-neutral so another parser can be added later without migrating
/// the page or rebuilding the order history. Only TARGET is imported today.
model OrderRecord {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  retailer     Retailer       @default(TARGET)
  orderNumber  String
  status       OrderStatus    @default(UNKNOWN)
  orderDate    DateTime?
  total        Decimal?       @db.Decimal(10, 2)
  currency     String         @default("USD")
  accountEmail String?
  lastUpdateAt DateTime?
  items        OrderItem[]
  shipments    Shipment[]
  messages     OrderMessage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([userId, retailer, orderNumber])
  @@index([userId, status, orderDate])
}

model OrderItem {
  id          String      @id @default(cuid())
  orderId     String
  order       OrderRecord @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  sku         String?
  quantity    Int         @default(1)
  unitPrice   Decimal?    @db.Decimal(10, 2)
  totalPrice  Decimal?    @db.Decimal(10, 2)
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([orderId])
  @@index([productId])
}

model Shipment {
  id             String      @id @default(cuid())
  orderId        String
  order          OrderRecord @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingNumber String
  carrier        String?
  status         OrderStatus @default(SHIPPED)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([orderId, trackingNumber])
  @@index([trackingNumber])
}

/// Every Gmail message is recorded once so repeated scans are idempotent.
/// Raw email bodies are deliberately not retained.
model OrderMessage {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String?
  order          OrderRecord? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  gmailMessageId String
  gmailThreadId  String?
  subject        String
  receivedAt     DateTime
  parsedStatus   OrderStatus?
  createdAt      DateTime     @default(now())

  @@unique([userId, gmailMessageId])
  @@index([userId, receivedAt])
  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String
  action    String
  changes   Json?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

// ---------- TCGplayer price cache ----------

/// A local mirror of sealed TCGplayer products, refreshed once a day from
/// TCGCSV. Searches hit this table, never the network, so the add form is
/// instant and we stay well inside TCGCSV's usage limits.
model TcgProduct {
  productId    Int       @id
  name         String
  categoryId   Int
  categoryName String
  groupId      Int
  groupName    String
  imageUrl     String?
  url          String?
  marketPrice  Decimal?  @db.Decimal(10, 2)
  pricedAt     DateTime?
  isPresale    Boolean   @default(false)
  releaseDate  DateTime? @db.Date

  @@index([name])
  @@index([categoryId])
}

/// One row. Tracks TCGCSV's build timestamp so we skip syncing when nothing
/// upstream has changed.
model SyncState {
  id                  String    @id @default("tcgcsv")
  lastStamp           String?
  lastSyncedAt        DateTime?
  presaleSyncedAt     DateTime?
  releaseDateSyncedAt DateTime?
  productCount        Int       @default(0)
  lastError           String?
}

/// One row per product per day. Written by the nightly sync and whenever
/// someone edits a market price by hand, so both linked and manual SKUs build
/// up history. The unique constraint keeps a day idempotent — syncing twice
/// updates that day's point rather than adding a second one.
model PriceSnapshot {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketPrice Decimal? @db.Decimal(10, 2)
  retailPrice Decimal? @db.Decimal(10, 2)
  capturedOn  DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([productId, capturedOn])
  @@index([productId, capturedOn])
}

/// US combined sales tax rates by ZIP, imported from a bundled CSV rather than
/// a live API — it's a setting people touch twice a year, so a network
/// dependency would be all risk and no benefit. Refresh quarterly by re-running
/// scripts/import-tax-rates.mjs.
model TaxRate {
  zip          String  @id
  state        String
  region       String?
  combinedRate Decimal @db.Decimal(7, 6)

  @@index([state])
}
