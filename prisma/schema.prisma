generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------

model User {
  id          String    @id @default(cuid())
  discordId   String    @unique
  username    String
  avatarUrl   String?
  role        Role      @default(MEMBER)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  // ROI settings — each person's own state and selling costs
  /// ZIP or Canadian postal code, used to look the tax rate up. Stored so a
  /// dataset refresh can update everyone's rate without them retyping it.
  postalCode        String?
  taxRate           Decimal @default(0.0) @db.Decimal(6, 5) // 0.0825 = 8.25%
  marketplaceFeePct Decimal @default(0.0) @db.Decimal(6, 5) // 0.1275 = 12.75%
  shippingCost      Decimal @default(0.0) @db.Decimal(10, 2)

  products Product[] @relation("ProductCreatedBy")
}

enum Role {
  ADMIN
  MEMBER
}

/// Pre-approve people before they ever log in. Matched on Discord ID.
model Whitelist {
  id        String   @id @default(cuid())
  discordId String   @unique
  note      String?
  createdAt DateTime @default(now())
}

// ---------- Catalog ----------

enum Retailer {
  TARGET
  WALMART
}

/// Everything here is typed in by a member. No scraping, no API keys.
model Product {
  id          String   @id @default(cuid())
  retailer    Retailer @default(TARGET)
  /// Target TCIN, Walmart item ID, or whatever you use to find it
  sku         String
  productName String
  brand       String   @default("Pokemon")
  imageUrl    String?
  productUrl  String?

  retailPrice Decimal  @db.Decimal(10, 2)
  marketPrice Decimal? @db.Decimal(10, 2)
  notes       String?
  /// Manually mark products that have not reached their general release date.
  prerelease  Boolean  @default(false)

  /// Link to a TCGplayer product. When set, the nightly sync overwrites
  /// marketPrice automatically. Leave null to keep typing prices by hand.
  tcgProductId  Int?
  tcgCategoryId Int?
  tcgGroupId    Int?

  active   Boolean  @default(true)
  /// Bumped whenever someone edits a price, so the table can show staleness
  pricedAt DateTime @default(now())

  snapshots PriceSnapshot[]

  createdById String?
  createdBy   User?    @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([retailer, sku])
  @@index([active])
}

// ---------- TCGplayer price cache ----------

/// A local mirror of sealed TCGplayer products, refreshed once a day from
/// TCGCSV. Searches hit this table, never the network, so the add form is
/// instant and we stay well inside TCGCSV's usage limits.
model TcgProduct {
  productId    Int       @id
  name         String
  categoryId   Int
  categoryName String
  groupId      Int
  groupName    String
  imageUrl     String?
  url          String?
  marketPrice  Decimal?  @db.Decimal(10, 2)
  pricedAt     DateTime?
  isPresale    Boolean   @default(false)

  @@index([name])
  @@index([categoryId])
}

/// One row. Tracks TCGCSV's build timestamp so we skip syncing when nothing
/// upstream has changed.
model SyncState {
  id              String    @id @default("tcgcsv")
  lastStamp       String?
  lastSyncedAt    DateTime?
  presaleSyncedAt DateTime?
  productCount    Int       @default(0)
  lastError       String?
}

/// One row per product per day. Written by the nightly sync and whenever
/// someone edits a market price by hand, so both linked and manual SKUs build
/// up history. The unique constraint keeps a day idempotent — syncing twice
/// updates that day's point rather than adding a second one.
model PriceSnapshot {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketPrice Decimal? @db.Decimal(10, 2)
  retailPrice Decimal? @db.Decimal(10, 2)
  capturedOn  DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([productId, capturedOn])
  @@index([productId, capturedOn])
}

/// US combined sales tax rates by ZIP, imported from a bundled CSV rather than
/// a live API — it's a setting people touch twice a year, so a network
/// dependency would be all risk and no benefit. Refresh quarterly by re-running
/// scripts/import-tax-rates.mjs.
model TaxRate {
  zip          String  @id
  state        String
  region       String?
  combinedRate Decimal @db.Decimal(7, 6)

  @@index([state])
}
