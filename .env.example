# Postgres (Neon, Supabase, Railway — anything with a connection string)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Discord OAuth app: https://discord.com/developers/applications
# Redirect URI: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Whitelist A: comma-separated Discord user IDs. These get admin.
ADMIN_DISCORD_IDS="123456789012345678"

# Whitelist B (optional): auto-allow anyone in your server holding one of these roles.
# Leave DISCORD_GUILD_ID blank to turn this off.
DISCORD_GUILD_ID=""
DISCORD_REQUIRED_ROLE_IDS=""
DISCORD_BOT_TOKEN=""
